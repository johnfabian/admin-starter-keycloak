# Copy to .env (prod) or .env.development (local dev) and fill in values.
# Vite auto-loads .env (always) and .env.development (when running `react-router dev`).
# Docker compose needs an explicit --env-file flag (see docker/README.md).

# ----- Postgres -----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ----- Keycloak -----
# Bootstrap admin only applies on first boot; manage via console afterward.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
# localhost for dev; real domain (with TLS + reverse proxy) for prod.
KEYCLOAK_HOSTNAME=

# ----- React app -----
# Only VITE_-prefixed vars are exposed to client code. Never put secrets here.
# VITE_KEYCLOAK_URL=
