# Copy to .env (prod) or .env.development (local dev) and fill in values.
# Vite auto-loads .env (always) and .env.development (when running `react-router dev`).
# Docker compose needs an explicit --env-file flag (see postgres/README.md and auth-server/README.md).

# -----------------------------------------------------------------------------
# Postgres
# Shared database used by Keycloak and application services.
# -----------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=admin_starter
POSTGRES_PORT=5434

# -----------------------------------------------------------------------------
# Keycloak server
# Bootstrap admin only applies on first boot; manage via console afterward.
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# localhost for dev; real domain (with TLS + reverse proxy) for prod.
KEYCLOAK_HOSTNAME=localhost

# -----------------------------------------------------------------------------
# Service URLs
# Direct local development defaults. Override for Traefik or production.
# -----------------------------------------------------------------------------
APP_EXTERNAL_URL=http://localhost:5173
KEYCLOAK_EXTERNAL_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8001
API_EXPRESS_EXTERNAL_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Shared OIDC realm
# Used by the web app and the future Express resource server.
# -----------------------------------------------------------------------------
KEYCLOAK_ISSUER=http://localhost:8080/realms/admin-starter

# -----------------------------------------------------------------------------
# Web app OIDC client
# Server-side React Router/BFF settings. Secrets should be long and random.
# -----------------------------------------------------------------------------
WEB_KEYCLOAK_CLIENT_ID=admin-starter-web
WEB_KEYCLOAK_CLIENT_SECRET=
WEB_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
WEB_AUTH_POST_LOGIN_REDIRECT_URI=http://localhost:5173/users/dashboard
WEB_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
WEB_SESSION_SECRET=
WEB_DATABASE_URL=postgresql://app:app@localhost:5434/admin_starter
WEB_TOKEN_ENCRYPTION_KEY=
WEB_RESOURCE_SERVER_BASE_URL=
WEB_KEYCLOAK_API_AUDIENCE=
WEB_TOKEN_REFRESH_LEEWAY_SECONDS=60
WEB_SESSION_LAST_SEEN_UPDATE_SECONDS=300

# -----------------------------------------------------------------------------
# API resource server audience
# Placeholder for the Express resource server that does not exist yet.
# -----------------------------------------------------------------------------
API_EXPRESS_KEYCLOAK_AUDIENCE=admin-starter-api-express

# Optional reusable CLI/test settings (do not store real credentials in examples).
# Optional dedicated realm-local CLI credentials (set both together).
# KEYCLOAK_AUTOMATION_USER=agent-automation@example.com
# KEYCLOAK_AUTOMATION_PASSWORD=replace-with-generated-secret
# Set KEYCLOAK_ADMIN_REALM to the dedicated account realm when using these.
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CONTAINER=app-keycloak
# Admin URL is resolved inside the selected container.
KEYCLOAK_ADMIN_URL=http://localhost:8080
# KEYCLOAK_REALM must agree with KEYCLOAK_ISSUER when explicitly set.
# KEYCLOAK_ADMIN_CLI=/absolute/path/to/kcadm.sh
# KEYCLOAK_CLI_VERSION=26.0.0
MAILPIT_URL=http://localhost:8025
E2E_POSTGRES_CONTAINER=app-postgres
