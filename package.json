{
  "name": "admin-starter-keycloak",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "docker compose -f docker/docker-compose.yml --env-file .env.development up -d --wait && echo Frontend: http://localhost:5173 && echo Keycloak: http://localhost:8080 && react-router dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "plan:new": "node scripts/create-plan.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env.development up -d --wait",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:traefik:up": "docker compose -f docker/docker-compose.traefik.yml --env-file .env.traefik up -d --build --wait",
    "docker:traefik:down": "docker compose -f docker/docker-compose.traefik.yml --env-file .env.traefik down",
    "docker:traefik:logs": "docker compose -f docker/docker-compose.traefik.yml --env-file .env.traefik logs -f"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/node": "7.15.0",
    "@react-router/serve": "7.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "5.1.40",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.15.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "8.0.12"
  }
}
