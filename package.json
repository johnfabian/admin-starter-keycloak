{
  "name": "admin-starter-keycloak",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "corepack pnpm db:up && corepack pnpm auth:up && echo Frontend: http://localhost:5173 && echo Keycloak: http://localhost:8080 && corepack pnpm web:dev",
    "dev:gateway": "corepack pnpm gateway:up && corepack pnpm db:gateway:up && corepack pnpm auth:gateway:up && corepack pnpm web:gateway:up && echo App: http://app.localhost && echo Keycloak: http://auth.localhost && echo Traefik: http://localhost:8081",
    "dev:gateway:down": "corepack pnpm web:gateway:down && corepack pnpm auth:gateway:down && corepack pnpm db:gateway:down && corepack pnpm gateway:down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "corepack pnpm format:check && corepack pnpm web:lint && corepack pnpm web:typecheck",
    "plan:new": "node scripts/create-plan.mjs",
    "web:dev": "dotenv -e .env.development -- corepack pnpm --dir web dev",
    "web:build": "dotenv -e .env.development -- corepack pnpm --dir web build",
    "web:start": "dotenv -e .env.development -- corepack pnpm --dir web start",
    "web:typecheck": "dotenv -e .env.development -- corepack pnpm --dir web typecheck",
    "web:lint": "corepack pnpm --dir web lint",
    "web:gateway:up": "docker compose -f web/docker-compose.gateway.yml --env-file .env.traefik up -d --build --wait",
    "web:gateway:down": "docker compose -f web/docker-compose.gateway.yml --env-file .env.traefik down",
    "web:gateway:logs": "docker compose -f web/docker-compose.gateway.yml --env-file .env.traefik logs -f",
    "db:up": "docker compose -f postgres/docker-compose.yml --env-file .env.development up -d --wait",
    "db:down": "docker compose -f postgres/docker-compose.yml down",
    "db:logs": "docker compose -f postgres/docker-compose.yml logs -f",
    "db:gateway:up": "docker compose -f postgres/docker-compose.gateway.yml --env-file .env.traefik up -d --wait",
    "db:gateway:down": "docker compose -f postgres/docker-compose.gateway.yml down",
    "db:gateway:logs": "docker compose -f postgres/docker-compose.gateway.yml logs -f",
    "auth:up": "docker compose -f auth-server/docker-compose.yml --env-file .env.development up -d --wait",
    "auth:down": "docker compose -f auth-server/docker-compose.yml down",
    "auth:logs": "docker compose -f auth-server/docker-compose.yml logs -f",
    "auth:gateway:up": "docker compose -f auth-server/docker-compose.gateway.yml --env-file .env.traefik up -d --wait",
    "auth:gateway:down": "docker compose -f auth-server/docker-compose.gateway.yml --env-file .env.traefik down",
    "auth:gateway:logs": "docker compose -f auth-server/docker-compose.gateway.yml --env-file .env.traefik logs -f",
    "gateway:up": "docker compose -f api-gateway/docker-compose.yml --env-file .env.traefik up -d --wait",
    "gateway:down": "docker compose -f api-gateway/docker-compose.yml down",
    "gateway:logs": "docker compose -f api-gateway/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.8.3"
  }
}
