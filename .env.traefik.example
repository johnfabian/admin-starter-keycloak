# Copy to .env.traefik for local Traefik testing.
# This stack routes browser traffic through Traefik on port 80:
# - http://app.localhost
# - http://auth.localhost
# - http://localhost:8081 for the Traefik dashboard

# -----------------------------------------------------------------------------
# Local Traefik hosts
# Browser-facing hostnames routed through Traefik.
# -----------------------------------------------------------------------------
APP_HOST=app.localhost
KEYCLOAK_HOST=auth.localhost
APP_EXTERNAL_URL=http://app.localhost
KEYCLOAK_EXTERNAL_URL=http://auth.localhost
API_EXTERNAL_URL=http://api.localhost
API_EXPRESS_EXTERNAL_URL=http://api-express.localhost

# -----------------------------------------------------------------------------
# Web runtime mode
# Keep this as development for local HTTP testing so auth cookies are not
# marked Secure. Use production only when the app is behind HTTPS.
# -----------------------------------------------------------------------------
APP_NODE_ENV=development

# -----------------------------------------------------------------------------
# Postgres
# Shared local database used by Keycloak and future API services.
# -----------------------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-traefik
POSTGRES_DB=admin_starter

# -----------------------------------------------------------------------------
# Keycloak server
# Bootstrap admin only applies on first boot; manage via console afterward.
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-traefik

# -----------------------------------------------------------------------------
# Shared OIDC realm
# Use the public Traefik hostname because browser redirects go through Traefik.
# -----------------------------------------------------------------------------
KEYCLOAK_ISSUER=http://auth.localhost/realms/admin-starter

# -----------------------------------------------------------------------------
# Web app OIDC client
# Server-side React Router/BFF settings. Keep secrets private.
# -----------------------------------------------------------------------------
WEB_KEYCLOAK_CLIENT_ID=admin-starter-web
WEB_KEYCLOAK_CLIENT_SECRET=
WEB_AUTH_REDIRECT_URI=http://app.localhost/auth/callback
WEB_AUTH_POST_LOGIN_REDIRECT_URI=http://app.localhost/users/dashboard
WEB_AUTH_POST_LOGOUT_REDIRECT_URI=http://app.localhost
WEB_SESSION_SECRET=replace-with-a-long-random-local-secret
WEB_DATABASE_URL=postgresql://app:change-me-local-traefik@postgres:5432/admin_starter
WEB_TOKEN_ENCRYPTION_KEY=replace-with-a-second-long-random-local-secret
WEB_RESOURCE_SERVER_BASE_URL=http://api.localhost
WEB_KEYCLOAK_API_AUDIENCE=
WEB_TOKEN_REFRESH_LEEWAY_SECONDS=60
WEB_SESSION_LAST_SEEN_UPDATE_SECONDS=300

# -----------------------------------------------------------------------------
# API resource server audience
# Placeholder for the Express resource server that does not exist yet.
# -----------------------------------------------------------------------------
API_EXPRESS_KEYCLOAK_AUDIENCE=admin-starter-api-express

# Optional reusable CLI/test settings (do not store real credentials in examples).
# Optional dedicated realm-local CLI credentials (set both together).
# KEYCLOAK_AUTOMATION_USER=agent-automation@example.com
# KEYCLOAK_AUTOMATION_PASSWORD=replace-with-generated-secret
# Set KEYCLOAK_ADMIN_REALM to the dedicated account realm when using these.
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CONTAINER=app-keycloak
# Admin URL is resolved inside the selected container.
KEYCLOAK_ADMIN_URL=http://localhost:8080
# KEYCLOAK_REALM must agree with KEYCLOAK_ISSUER when explicitly set.
# KEYCLOAK_ADMIN_CLI=/absolute/path/to/kcadm.sh
# KEYCLOAK_CLI_VERSION=26.0.0
MAILPIT_URL=http://localhost:8025
E2E_POSTGRES_CONTAINER=app-postgres
