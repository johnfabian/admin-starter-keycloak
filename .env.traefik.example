# Copy to .env.traefik for local Traefik testing.
# This stack routes browser traffic through Traefik on port 80:
# - http://app.localhost
# - http://auth.localhost
# - http://localhost:8081 for the Traefik dashboard

# ----- Local Traefik hosts -----
APP_HOST=app.localhost
KEYCLOAK_HOST=auth.localhost
APP_EXTERNAL_URL=http://app.localhost
KEYCLOAK_EXTERNAL_URL=http://auth.localhost

# Keep this as development for local HTTP testing so auth cookies are not
# marked Secure. Use production only when the app is behind HTTPS.
APP_NODE_ENV=development

# ----- Postgres -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-traefik
POSTGRES_DB=admin_starter

# ----- Keycloak -----
# Bootstrap admin only applies on first boot; manage via console afterward.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-traefik

# ----- Auth / OIDC -----
KEYCLOAK_ISSUER=http://auth.localhost/realms/admin-starter
KEYCLOAK_CLIENT_ID=admin-starter-web
KEYCLOAK_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://app.localhost/auth/callback
AUTH_POST_LOGIN_REDIRECT_URI=http://app.localhost/users/dashboard
AUTH_POST_LOGOUT_REDIRECT_URI=http://app.localhost
SESSION_SECRET=replace-with-a-long-random-local-secret
